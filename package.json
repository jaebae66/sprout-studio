{
  "name": "sprout-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test": "npm run build && playwright test --project=unit --project=mcp --project=app",
    "test:packaged": "npm run package:desktop && playwright test --project=packaged",
    "test:report": "playwright show-report",
    "mcp": "node mcp/server.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "dompurify": "^3.4.16",
    "jszip": "^3.10.1",
    "marked": "^18.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/mcp": "^0.0.83",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.5.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.21.5": true
  }
}
